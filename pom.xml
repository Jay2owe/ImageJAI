<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.scijava</groupId>
        <artifactId>pom-scijava</artifactId>
        <version>37.0.0</version>
        <relativePath />
    </parent>

    <groupId>imagejai</groupId>
    <artifactId>imagej-ai</artifactId>
    <version>0.6.0</version>
    <packaging>jar</packaging>

    <name>ImageJ AI Assistant</name>
    <description>AI-powered assistant for ImageJ/Fiji. Natural language control of image analysis.</description>
    <url>https://github.com/Jay2owe/ImageJAI</url>
    <inceptionYear>2026</inceptionYear>
    <organization>
        <name>UK Dementia Research Institute at Imperial College London</name>
        <url>https://ukdri.ac.uk/centres/imperial</url>
    </organization>

    <licenses>
        <license>
            <name>BSD 3-Clause License</name>
            <url>https://opensource.org/licenses/BSD-3-Clause</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Jay2owe</id>
            <name>Jamie Malcolm</name>
            <email>jamiemalcolm12@gmail.com</email>
            <url>https://github.com/Jay2owe</url>
            <organization>UK Dementia Research Institute at Imperial College London</organization>
            <organizationUrl>https://www.ukdri.ac.uk/labs/brancaccio-lab</organizationUrl>
            <properties>
                <orcid>0009-0008-3862-2776</orcid>
            </properties>
            <roles>
                <role>founder</role>
                <role>lead</role>
                <role>developer</role>
                <role>maintainer</role>
            </roles>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/Jay2owe/ImageJAI.git</connection>
        <developerConnection>scm:git:git@github.com:Jay2owe/ImageJAI.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/Jay2owe/ImageJAI</url>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/Jay2owe/ImageJAI/issues</url>
    </issueManagement>

    <properties>
        <package-name>imagejai</package-name>
        <license.licenseName>bsd_3</license.licenseName>
        <license.copyrightOwners>Jamie Malcolm</license.copyrightOwners>
        <!-- Canonical archive time for byte-for-byte reproducible release JARs.
             Change this only when deliberately starting a new release line. -->
        <project.build.outputTimestamp>2026-09-18T00:00:00Z</project.build.outputTimestamp>
        <!-- Java 8 target so the plugin also runs on older Fiji installs.
             Build JDK stays at 25. Tests are compiled for Java 11 because they
             only ever run on the build JDK. -->
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
        <maven.compiler.release>8</maven.compiler.release>
        <maven.compiler.testRelease>11</maven.compiler.testRelease>
        <scijava.jvm.build.version>[11,)</scijava.jvm.build.version>
        <!-- Override scijava's enforcer to allow building with newer JDKs -->
        <enforcer.skip>true</enforcer.skip>
        <!-- pom-scijava 37 pins JaCoCo 0.8.10, which cannot instrument JDK 23 classes. -->
        <jacoco-maven-plugin.version>0.8.13</jacoco-maven-plugin.version>
    </properties>

    <repositories>
        <repository>
            <id>scijava.public</id>
            <url>https://maven.scijava.org/content/groups/public</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- ImageJ2 / SciJava (provided by Fiji at runtime) -->
        <dependency>
            <groupId>net.imagej</groupId>
            <artifactId>imagej</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.imagej</groupId>
            <artifactId>ij</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.scijava</groupId>
            <artifactId>scijava-common</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>ome</groupId>
            <artifactId>formats-gpl</artifactId>
            <version>8.1.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>ome</groupId>
            <artifactId>formats-api</artifactId>
            <version>8.1.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>ome</groupId>
            <artifactId>formats-bsd</artifactId>
            <version>8.1.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- Gson, bundled and relocated (see the shade plugin): older Fijis ship
             Gson releases without JsonParser.parseString, which this code uses. -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <scope>compile</scope>
        </dependency>

        <!-- Native Windows calls (credential store, PATH broadcast, child PIDs) -->
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.13.0</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.13.0</version>
            <scope>compile</scope>
        </dependency>

        <!-- SnakeYAML for ProviderRegistry (Phase D). SafeConstructor only;
             see risk #16 in docs/multi_provider/07_implementation_plan.md. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
            <scope>compile</scope>
        </dependency>

        <!-- Data Governance statement PDF generation (stage 06). -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.2</version>
            <scope>compile</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>**/*conflicted copy*</exclude>
                    <exclude>**/*premerge*</exclude>
                    <exclude>**/*.bak</exclude>
                    <exclude>**/*.tmp</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>agent/providers</directory>
                <targetPath>agent/providers</targetPath>
                <includes>
                    <include>proxy.py</include>
                    <include>litellm.config.yaml</include>
                    <include>requirements.txt</include>
                    <include>models.yaml</include>
                    <include>ollama_model_sizes.json</include>
                </includes>
            </resource>
            <resource>
                <directory>agent</directory>
                <targetPath>imagejai</targetPath>
                <includes>
                    <include>command_manifest.json</include>
                </includes>
            </resource>
            <!-- A JAR-only Fiji install still needs a real Python workspace for
                 CLI agents and the bundled Ollama/Gemma loop. Keep this list
                 deliberately narrow: runtime code/context only, never tests,
                 caches, credentials, logs, or generated provider state. -->
            <resource>
                <directory>agent</directory>
                <targetPath>agent-runtime</targetPath>
                <filtering>false</filtering>
                <includes>
                    <include>.aider.conventions.md</include>
                    <include>.clinerules</include>
                    <include>.cursorrules</include>
                    <include>AGENTS.md</include>
                    <include>CLAUDE.md</include>
                    <include>GEMINI.md</include>
                    <!-- Not a duplicate of the imagejai/ copy above. ij.py and
                         methods_table.py resolve the manifest as a sibling of
                         their own __file__, and ij.py does it at module scope,
                         so the classpath copy is unreachable to them: without
                         this one, `import ij` raises in a JAR-only install.
                         Remove it only if those readers stop doing that. -->
                    <include>command_manifest.json</include>
                    <include>__init__.py</include>
                    <include>pyproject.toml</include>
                    <include>adviser.py</include>
                    <include>auditor.py</include>
                    <include>autopsy.py</include>
                    <include>ij.py</include>
                    <include>image_diff.py</include>
                    <include>imagej_helpers.py</include>
                    <include>macro_lint.py</include>
                    <include>methods_table.py</include>
                    <include>pixels.py</include>
                    <include>practice.py</include>
                    <include>probe_plugin.py</include>
                    <include>recipe_search.py</include>
                    <include>results_parser.py</include>
                    <include>run_recipe.py</include>
                    <include>scan_plugins.py</include>
                    <include>session_log.py</include>
                    <include>sync_context.py</include>
                    <include>train_agent.py</include>
                    <include>imagej_use/**/*</include>
                    <include>console/**/*</include>
                    <include>contexts/**/*</include>
                    <include>gemma4_31b/**/*</include>
                    <include>ollama_agent/__init__.py</include>
                    <include>ollama_agent/budget_ceiling.py</include>
                    <include>providers/__init__.py</include>
                    <include>providers/agent_cli.py</include>
                    <include>providers/anthropic_native.py</include>
                    <include>providers/base.py</include>
                    <include>providers/gemini_native.py</include>
                    <include>providers/litellm.config.yaml</include>
                    <include>providers/litellm_proxy.py</include>
                    <include>providers/models.yaml</include>
                    <include>providers/ollama_model_sizes.json</include>
                    <include>providers/proxy.py</include>
                    <include>providers/requirements.txt</include>
                    <include>providers/router.py</include>
                    <include>macro_sets/**/*</include>
                    <include>recipes/**/*</include>
                    <include>references/**/*</include>
                </includes>
                <excludes>
                    <exclude>**/__pycache__/**</exclude>
                    <exclude>**/*.pyc</exclude>
                    <exclude>**/tests/**</exclude>
                    <exclude>**/.plugin_cache/**</exclude>
                    <exclude>**/.pytest_cache/**</exclude>
                    <exclude>**/*.egg-info/**</exclude>
                    <exclude>contexts/_snapshots/**</exclude>
                    <exclude>contexts/test_*.py</exclude>
                    <exclude>providers/_spike/**</exclude>
                    <exclude>providers/test_*.py</exclude>
                    <exclude>providers/proxy.auth</exclude>
                    <exclude>providers/proxy.runtime.json</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <excludes>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                    <excludedGroups>imagejai.test.Benchmark</excludedGroups>
                    <systemPropertyVariables>
                        <!-- Keep the test run out of the developer's live
                             ~/.imagej-ai. AiRootPanel honours
                             settings.refreshOnStartup, so simply constructing
                             the panel in a test used to fetch provider model
                             lists over the network and write into the real
                             model cache. Settings.getConfigDir() reads
                             user.home on every call, so redirecting it here
                             makes the suite hermetic. The directory lives in
                             the system temp area, not under target/: this
                             checkout sits in a synced Dropbox folder, and the
                             sync client holds handles open long enough to break
                             recursive test cleanup. -->
                        <user.home>${java.io.tmpdir}/imagejai-test-home</user.home>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>8</source>
                    <target>8</target>
                    <excludes>
                        <exclude>**/*conflicted copy*.java</exclude>
                    </excludes>
                    <testExcludes>
                        <testExclude>**/*conflicted copy*.java</testExclude>
                    </testExcludes>
                </configuration>
            </plugin>
            <!-- Generate SciJava plugin annotation index -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <outputTimestamp>${project.build.outputTimestamp}</outputTimestamp>
                    <archive>
                        <manifest>
                            <!-- The release JAR shades these libraries; a Class-Path
                                 list makes Fiji's updater demand duplicate JARs. -->
                            <addClasspath>false</addClasspath>
                            <packageName>imagejai</packageName>
                        </manifest>
                        <!-- pom-scijava otherwise inserts the wall-clock build
                             time, which makes identical builds hash differently. -->
                        <manifestEntries>
                            <Implementation-Date>${project.build.outputTimestamp}</Implementation-Date>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <minimizeJar>false</minimizeJar>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <!-- Dependency POMs are not runtime API
                                             and violate the plugin artifact policy. -->
                                        <exclude>META-INF/maven/**</exclude>
                                        <!-- Java 9 module descriptors cannot load on Java 8. -->
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/versions/*/module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <relocations>
                                <relocation>
                                    <pattern>com.google.gson</pattern>
                                    <shadedPattern>imagejai.shaded.gson</shadedPattern>
                                </relocation>
                            </relocations>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer" />
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.2.5</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includes>
                                <include>**/*IntegrationTest.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.2.5</version>
                        <configuration>
                            <groups>imagejai.test.Benchmark</groups>
                            <excludedGroups combine.self="override" />
                            <excludes>
                                <exclude>**/*IntegrationTest.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
