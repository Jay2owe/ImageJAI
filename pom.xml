<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.scijava</groupId>
        <artifactId>pom-scijava</artifactId>
        <version>37.0.0</version>
        <relativePath />
    </parent>

    <groupId>imagejai</groupId>
    <artifactId>imagej-ai</artifactId>
    <version>0.3.0</version>
    <packaging>jar</packaging>

    <name>ImageJ AI Assistant</name>
    <description>AI-powered assistant for ImageJ/Fiji. Natural language control of image analysis.</description>
    <url>https://github.com/Jay2owe/ImageJAI</url>
    <inceptionYear>2026</inceptionYear>
    <organization>
        <name>UK Dementia Research Institute at Imperial College London</name>
        <url>https://ukdri.ac.uk/centres/imperial</url>
    </organization>

    <licenses>
        <license>
            <name>BSD 3-Clause License</name>
            <url>https://opensource.org/licenses/BSD-3-Clause</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>Jay2owe</id>
            <name>Jamie Malcolm</name>
            <email>jamiemalcolm12@gmail.com</email>
            <url>https://github.com/Jay2owe</url>
            <organization>UK Dementia Research Institute at Imperial College London</organization>
            <organizationUrl>https://www.ukdri.ac.uk/labs/brancaccio-lab</organizationUrl>
            <properties>
                <orcid>0009-0008-3862-2776</orcid>
            </properties>
            <roles>
                <role>founder</role>
                <role>lead</role>
                <role>developer</role>
                <role>maintainer</role>
            </roles>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/Jay2owe/ImageJAI.git</connection>
        <developerConnection>scm:git:git@github.com:Jay2owe/ImageJAI.git</developerConnection>
        <tag>HEAD</tag>
        <url>https://github.com/Jay2owe/ImageJAI</url>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/Jay2owe/ImageJAI/issues</url>
    </issueManagement>

    <properties>
        <package-name>imagejai</package-name>
        <license.licenseName>bsd_3</license.licenseName>
        <license.copyrightOwners>Jamie Malcolm</license.copyrightOwners>
        <!-- Java 11 target: required by pty4j / JediTerm (stage 05).
             Fiji ships a JRE 21+ so runtime is fine; build JDK stays at 25.
             NB: pom-scijava sets maven.compiler.release=8 in its BOM, and
             `release` trumps `source`/`target` — override it here explicitly. -->
        <maven.compiler.source>11</maven.compiler.source>
        <maven.compiler.target>11</maven.compiler.target>
        <maven.compiler.release>11</maven.compiler.release>
        <scijava.jvm.build.version>[11,)</scijava.jvm.build.version>
        <!-- Override scijava's enforcer to allow building with newer JDKs -->
        <enforcer.skip>true</enforcer.skip>
        <!-- pom-scijava 37 pins JaCoCo 0.8.10, which cannot instrument JDK 23 classes. -->
        <jacoco-maven-plugin.version>0.8.13</jacoco-maven-plugin.version>
        <!-- pty4j / JediTerm resolve Kotlin 2.x transitive artifacts. Keep this
             explicit so SciJava's older BOM does not pull a mismatched stdlib. -->
        <kotlin.version>2.1.21</kotlin.version>
        <!-- SciJava still manages kotlin-stdlib-common, which Kotlin 2.x no
             longer publishes as a jar. Keep that retired compatibility artifact
             on SciJava's original line while the terminal deps use Kotlin 2.x. -->
        <kotlin-stdlib-common.version>1.9.22</kotlin-stdlib-common.version>
    </properties>

    <repositories>
        <repository>
            <id>jetbrains-intellij-dependencies</id>
            <url>https://packages.jetbrains.team/maven/p/ij/intellij-dependencies</url>
        </repository>
        <repository>
            <id>scijava.public</id>
            <url>https://maven.scijava.org/content/groups/public</url>
        </repository>
    </repositories>

    <dependencies>
        <!-- ImageJ2 / SciJava (provided by Fiji at runtime) -->
        <dependency>
            <groupId>net.imagej</groupId>
            <artifactId>imagej</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.imagej</groupId>
            <artifactId>ij</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.scijava</groupId>
            <artifactId>scijava-common</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>ome</groupId>
            <artifactId>formats-gpl</artifactId>
            <version>8.1.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>ome</groupId>
            <artifactId>formats-api</artifactId>
            <version>8.1.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>ome</groupId>
            <artifactId>formats-bsd</artifactId>
            <version>8.1.1</version>
            <scope>provided</scope>
        </dependency>

        <!-- Gson (provided by Fiji at runtime — ships as jars/gson-2.10.1.jar) -->
        <dependency>
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Embedded terminal backend (stage 05) -->
        <dependency>
            <groupId>org.jetbrains.pty4j</groupId>
            <artifactId>pty4j</artifactId>
            <version>0.13.12</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna</artifactId>
            <version>5.13.0</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>net.java.dev.jna</groupId>
            <artifactId>jna-platform</artifactId>
            <version>5.13.0</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.jediterm</groupId>
            <artifactId>jediterm-core</artifactId>
            <version>3.66</version>
            <scope>compile</scope>
        </dependency>
        <dependency>
            <groupId>org.jetbrains.jediterm</groupId>
            <artifactId>jediterm-ui</artifactId>
            <version>3.66</version>
            <scope>compile</scope>
        </dependency>

        <!-- SnakeYAML for ProviderRegistry (Phase D). SafeConstructor only;
             see risk #16 in docs/multi_provider/07_implementation_plan.md. -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
            <version>2.2</version>
            <scope>compile</scope>
        </dependency>

        <!-- Data Governance statement PDF generation (stage 06). -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>3.0.2</version>
            <scope>compile</scope>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>**/*conflicted copy*</exclude>
                    <exclude>**/*premerge*</exclude>
                    <exclude>**/*.bak</exclude>
                    <exclude>**/*.tmp</exclude>
                </excludes>
            </resource>
            <resource>
                <directory>agent/providers</directory>
                <targetPath>agent/providers</targetPath>
                <includes>
                    <include>proxy.py</include>
                    <include>litellm.config.yaml</include>
                    <include>requirements.txt</include>
                    <include>models.yaml</include>
                    <include>ollama_model_sizes.json</include>
                </includes>
            </resource>
            <resource>
                <directory>agent</directory>
                <targetPath>imagejai</targetPath>
                <includes>
                    <include>command_manifest.json</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <excludes>
                        <exclude>**/*IntegrationTest.java</exclude>
                    </excludes>
                    <excludedGroups>imagejai.test.Benchmark</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>11</source>
                    <target>11</target>
                    <excludes>
                        <exclude>**/*conflicted copy*.java</exclude>
                    </excludes>
                    <testExcludes>
                        <testExclude>**/*conflicted copy*.java</testExclude>
                    </testExcludes>
                </configuration>
            </plugin>
            <!-- Generate SciJava plugin annotation index -->
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <packageName>imagejai</packageName>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <minimizeJar>false</minimizeJar>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer" />
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <version>3.2.5</version>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <includes>
                                <include>**/*IntegrationTest.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>benchmark</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.2.5</version>
                        <configuration>
                            <groups>imagejai.test.Benchmark</groups>
                            <excludedGroups combine.self="override" />
                            <excludes>
                                <exclude>**/*IntegrationTest.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
