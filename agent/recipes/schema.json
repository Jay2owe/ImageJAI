{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://imagejai.local/schemas/recipe-v1.json",
  "title": "ImageJAI executable recipe",
  "type": "object",
  "required": [
    "schema_version", "name", "id", "description", "domain", "difficulty",
    "preconditions", "parameters", "steps"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "name": {"type": "string", "minLength": 1},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
    "description": {"type": "string", "minLength": 1},
    "domain": {"type": "string", "minLength": 1},
    "difficulty": {"enum": ["beginner", "intermediate", "advanced"]},
    "preconditions": {"$ref": "#/$defs/preconditions"},
    "parameters": {
      "type": "array",
      "items": {"$ref": "#/$defs/parameter"}
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"}
    },
    "postconditions": {"$ref": "#/$defs/contracts"},
    "validation": {"$ref": "#/$defs/contracts"},
    "outputs": {"type": "array"},
    "known_issues": {"type": "array"},
    "tags": {"type": "array", "items": {"type": "string"}},
    "created": {"type": "object"},
    "related_recipes": {"type": "array"},
    "decision_points": {"type": "array"},
    "quality_settings": {"type": "object"},
    "decisions": {"type": "array"},
    "display_ranges": {"type": "object"},
    "animations": {"type": "object"},
    "naming": {"type": "string"},
    "batch_script": {"type": "object"},
    "groovy_reference": {"type": "string"},
    "tips": {"type": "array"},
    "agent_instructions": {"type": "string"}
  },
  "additionalProperties": false,
  "$defs": {
    "preconditions": {
      "type": "object",
      "properties": {
        "image_type": {"type": "array", "items": {"type": "string"}},
        "min_channels": {"type": "integer", "minimum": 0},
        "needs_stack": {"type": "boolean"},
        "needs_time": {"type": "boolean"},
        "needs_calibration": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "parameter": {
      "type": "object",
      "required": ["name", "type", "default"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "label": {"type": "string"},
        "type": {"enum": ["numeric", "string", "text", "choice", "boolean"]},
        "default": {},
        "range": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": {"type": "number"}
        },
        "options": {"type": "array", "minItems": 1},
        "description": {"type": "string"},
        "image_specific": {"type": "boolean"},
        "value": {},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "required": ["parameter"],
      "properties": {
        "parameter": {"type": "string"},
        "equals": {},
        "not_equals": {},
        "in": {"type": "array"}
      },
      "oneOf": [
        {"required": ["equals"]},
        {"required": ["not_equals"]},
        {"required": ["in"]}
      ],
      "additionalProperties": false
    },
    "contract": {
      "oneOf": [
        {"type": "string"},
        {
          "type": "object",
          "required": ["check"],
          "properties": {
            "check": {"type": "string", "minLength": 1},
            "method": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {"enum": ["acknowledgement", "image_open", "results_nonempty"]},
            "prompt": {"type": "string"}
          },
          "additionalProperties": false
        }
      ]
    },
    "contracts": {
      "oneOf": [
        {"$ref": "#/$defs/contract"},
        {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/contract"}}
      ]
    },
    "step": {
      "type": "object",
      "required": ["description"],
      "properties": {
        "id": {"type": ["string", "integer"]},
        "name": {"type": "string"},
        "description": {"type": "string", "minLength": 1},
        "type": {"enum": ["macro", "script", "manual"]},
        "macro": {"type": "string"},
        "code": {"type": "string"},
        "script": {"type": "string"},
        "groovy": {"type": "string"},
        "file": {"type": "string"},
        "language": {"enum": ["groovy", "jython", "javascript"]},
        "instructions": {"type": "string"},
        "when": {"$ref": "#/$defs/condition"},
        "decision_point": {"type": "boolean"},
        "decision_logic": {"type": "string"},
        "capture_after": {"type": "boolean"},
        "validate": {"$ref": "#/$defs/contracts"},
        "validation": {"$ref": "#/$defs/contracts"},
        "notes": {"type": "string"},
        "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
        "expected_output": {"type": "string"},
        "source": {"enum": ["macro", "script"]}
      },
      "oneOf": [
        {
          "properties": {"type": {"const": "macro"}},
          "oneOf": [
            {"required": ["macro"], "not": {"required": ["code"]}},
            {"required": ["code"], "not": {"required": ["macro"]}}
          ],
          "not": {"anyOf": [
            {"required": ["script"]}, {"required": ["groovy"]},
            {"required": ["file"]}, {"required": ["instructions"]}
          ]}
        },
        {
          "properties": {"type": {"const": "script"}},
          "anyOf": [
            {"required": ["script"]}, {"required": ["groovy"]},
            {"required": ["file"]},
            {"required": ["type", "code"], "properties": {"type": {"const": "script"}}}
          ],
          "not": {"anyOf": [
            {"required": ["macro"]}, {"required": ["instructions"]}
          ]}
        },
        {
          "required": ["type"],
          "properties": {"type": {"const": "manual"}},
          "anyOf": [{"required": ["instructions"]}, {"required": ["notes"]}],
          "not": {"anyOf": [
            {"required": ["macro"]}, {"required": ["code"]},
            {"required": ["script"]}, {"required": ["groovy"]},
            {"required": ["file"]}
          ]}
        }
      ],
      "additionalProperties": false
    }
  }
}
